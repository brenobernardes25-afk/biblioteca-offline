<!-- Os manuais do Exército Brasileiro só existem em http://. Nenhum outro servidor pode usar HTTP. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">bdex.eb.mil.br</domain>
    </domain-config>
</network-security-config>
