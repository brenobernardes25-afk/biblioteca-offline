<?xml version="1.0" encoding="utf-8"?>
<!-- Os manuais do Exército Brasileiro só existem em http://. Nenhum outro servidor pode usar HTTP. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">bdex.eb.mil.br</domain>
        <!-- O mapa do Brasil do app: servidor do próprio celular, nada sai dele. -->
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
